# Copie para /opt/salao-max/.env no servidor (nunca versione o .env real).

POSTGRES_DB=salao
POSTGRES_USER=salao
POSTGRES_PASSWORD=troque-esta-senha

# Mínimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=

CORS_ORIGINS=https://salaomax.focodev.com.br
APP_PUBLIC_URL=https://salaomax.focodev.com.br

# Porta local que o túnel Cloudflare acessa (http://127.0.0.1:8089)
HTTP_PORT=8089

# Token que o GitHub Actions usa para publicar o APK (mesmo valor do secret APP_RELEASE_DEPLOY_TOKEN)
APP_RELEASE_DEPLOY_TOKEN=
APP_RELEASES_MAX_COUNT=2

# Super-admin da plataforma (bloqueio de salões/usuários, releases do app)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Cloudflare R2 (fotos do portfólio, como os vídeos do foco-academia). Sem estas variáveis as fotos
# ficam no disco do servidor (volume salon_media). Gere a chave em R2 → Manage API Tokens com
# "Object Read & Write" no bucket salao-max-fotos e cole aqui direto no servidor (nunca no repositório).
R2_BUCKET=salao-max-fotos
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Domínio público do bucket (R2 → bucket → Settings → Public access → r2.dev ou domínio próprio)
R2_PUBLIC_BASE_URL=https://pub-XXXXXXXX.r2.dev

# Backup do banco: cópia FORA do servidor num bucket PRIVADO do R2 (mesmas chaves R2_* acima). Vazio = só no servidor.
# Nunca use o bucket de fotos (é público). Veja docs/DEPLOY.md.
BACKUP_BUCKET=
BACKUP_KEEP_DAYS=14

# E-mails (recuperar senha): conta no Resend (https://resend.com) com o domínio verificado. Veja docs/DEPLOY.md.
RESEND_API_KEY=
MAIL_FROM="Salão Max <nao-responda@salaomax.focodev.com.br>"

# Assinatura pela Google Play: JSON da conta de serviço em base64 (`base64 -w0 chave.json`). Veja docs/PLAY_STORE.md.
PLAY_SERVICE_ACCOUNT_JSON_BASE64=
