# Copie para /opt/salao-max/.env no servidor (nunca versione o .env real).

POSTGRES_DB=salao
POSTGRES_USER=salao
POSTGRES_PASSWORD=troque-esta-senha

# Mínimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=

CORS_ORIGINS=https://salaomax.focodev.com.br
APP_PUBLIC_URL=https://salaomax.focodev.com.br

# Porta local que o túnel Cloudflare acessa (http://127.0.0.1:8089)
HTTP_PORT=8089

# Token que o GitHub Actions usa para publicar o APK (mesmo valor do secret APP_RELEASE_DEPLOY_TOKEN)
APP_RELEASE_DEPLOY_TOKEN=
APP_RELEASES_MAX_COUNT=2

# Super-admin da plataforma (bloqueio de salões/usuários, releases do app)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
